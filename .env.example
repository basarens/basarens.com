# Set this value only in your local .env.local file and in Vercel.
# It is checked on the server and is never sent to visitors' browsers.
ROME_QUIZ_ANSWER=choose-a-private-answer

# Finance: copy these values from your private Supabase project into .env.local and Vercel.
# Use the publishable key, never the service role or secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Memories: private photo inbox, separate server-side credentials from Finance.
# Supabase secret/service-role key: server only, NEVER prefix with NEXT_PUBLIC_.
MEMORIES_SUPABASE_SECRET_KEY=

# Optional local LAN preview: comma-separated hostnames/IPs, no protocol or port.
NEXT_DEV_ALLOWED_ORIGINS=
