# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Imported Treasure Hunt source: the database is not used by the game and
# should never be published with the website.
/treasure-hunt/database.db
/treasure-hunt/static/background-music/the-look.mp3

# Personal source sheet music stays local; the files selected for the public
# repertoire live in /public/repertoire instead.
/music/

# Generated from treasure-hunt/templates and treasure-hunt/static before dev/build.
/public/games/treasure-hunt/
